# Required AutoDL developer token. Keep this only in Railway Variables.
AUTODL_TOKEN=replace-with-your-autodl-developer-token

# Required instance id, for example pro-76576c61fdf1
AUTODL_INSTANCE_UUID=pro-your-instance-id

# Required. At least 24 bytes. Use a long random value.
DASHBOARD_KEY=replace-with-a-long-random-dashboard-key

# Required when BOOT_GUARD_ENABLED=true. Keep this server-side only.
# Example generator: python3 -c "import secrets; print(secrets.token_hex(32))"
BOOT_GUARD_SECRET=replace-with-at-least-32-random-bytes

# Enabled by default. Set false only for emergency troubleshooting.
BOOT_GUARD_ENABLED=true

# Usually auto-detected from Railway's RAILWAY_PUBLIC_DOMAIN.
# Set this only when you want the guard to use a custom HTTPS domain.
# BOOT_GUARD_PUBLIC_ORIGIN=https://your-console.example.com

# Server-controlled AutoDL command. The browser can no longer override it.
AUTODL_START_COMMAND=bash /root/zealman-app/start-comfyui.sh && bash /root/zealman-app/start-services.sh

# AutoDL service port used as the ComfyUI readiness gate.
COMFYUI_SERVICE_PORT=6008
PROBE_TIMEOUT_MS=5000

# Readiness probes are restricted to this hostname/suffix.
AUTODL_SERVICE_HOST_SUFFIX=.autodl.com

# Optional boot-guard tuning.
# BOOT_GUARD_POLL_MS=15000
# BOOT_GUARD_GRACE_MS=90000
# BOOT_GUARD_HEARTBEAT_TIMEOUT_MS=120000
# BOOT_GUARD_RECONNECT_GRACE_MS=90000
# BOOT_GUARD_AUTH_WINDOW_MS=1200000

# Railway provides PORT automatically. Local default is 3000.
PORT=3000
